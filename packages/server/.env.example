# Required: paths to repositories (colon-separated)
INCREA_REPO="/path/to/repo1:/path/to/repo2"

# API authentication (choose one):
# Option A: Direct Anthropic API
ANTHROPIC_API_KEY="your-api-key"

# Option B: GLM via the Anthropic-compatible API (defaults to glm-5.3)
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# ANTHROPIC_AUTH_TOKEN=your-glm-api-key

# Optional: server port (default: 3000)
# PORT=3000

# Optional: chat log directory (default: chat-logs)
# CHAT_LOGS_DIR=chat-logs
